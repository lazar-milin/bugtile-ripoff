# Copy this file to .env and fill it in. `npm start` loads .env; never commit it.

# Discord application credentials from the Developer Portal. Only needed inside
# Discord. The secret stays on the server.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Lets people play in a browser without Discord. Set to false for a Discord-only host.
ALLOW_GUESTS=true

# 0.0.0.0 allows same-network play and container hosts; 127.0.0.1 keeps it on this computer.
HOST=0.0.0.0
PORT=3007
